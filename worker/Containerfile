# Source and wheels are verified and built offline by scripts/build-worker.sh.
FROM docker.io/library/python@sha256:cd89c30eda26ee911a4611b18680086e0ea42e6f5f8cbe653d07fa7958c9cec8
COPY site/ /opt/python/
COPY dwg2dxf /usr/local/bin/dwg2dxf
COPY render.py /opt/cadviewer/render.py
COPY fonts/ /usr/share/fonts/cadviewer/
COPY licenses/ /usr/share/licenses/cadviewer/
COPY libredwg-0.14.tar.xz /usr/share/cadviewer/source/libredwg-0.14.tar.xz
USER 65534:65534
WORKDIR /scratch
ENV PYTHONPATH=/opt/python PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1
ENTRYPOINT ["/usr/local/bin/python3", "/opt/cadviewer/render.py"]
